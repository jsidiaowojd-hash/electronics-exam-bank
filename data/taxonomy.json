{
  "version": "1.0",
  "note": "中山大学 885 电子技术（模拟电路 + 数字电路）考点分类树。这是一切导航与搜索的唯一分类来源。分类原则：只套用考研 885 体系，不按普通教材随意拆章；无法确定的题目一律标记“待人工确认”，不得强行归类。",
  "subjects": [
    {
      "id": "analog",
      "name": "模拟电路",
      "chapters": [
        {
          "id": "analog-semiconductor",
          "name": "半导体基础",
          "topics": ["本征与杂质半导体", "PN 结", "二极管伏安特性"]
        },
        {
          "id": "analog-diode",
          "name": "二极管",
          "topics": ["理想二极管", "稳压二极管", "钳位与限幅", "整流与滤波"]
        },
        {
          "id": "analog-bjt",
          "name": "三极管",
          "topics": ["BJT 工作原理", "电流放大系数", "输入输出特性曲线", "工作区判断"]
        },
        {
          "id": "analog-basic-amp",
          "name": "基本放大电路",
          "topics": ["共射放大", "共集放大", "共基放大", "静态工作点", "微变等效电路", "增益与输入输出电阻"]
        },
        {
          "id": "analog-multistage",
          "name": "多级放大电路",
          "topics": ["级联增益", "直接耦合", "阻容耦合", "零点漂移"]
        },
        {
          "id": "analog-opamp",
          "name": "集成运算放大电路",
          "topics": ["差分放大", "恒流源", "电流镜", "共模抑制比", "输入输出特性", "运放参数"]
        },
        {
          "id": "analog-feedback",
          "name": "反馈",
          "topics": ["正负反馈判断", "组态判断", "深度负反馈", "反馈对性能的影响", "稳定性"]
        },
        {
          "id": "analog-opcircuit",
          "name": "运算电路",
          "topics": ["比例运算", "加减运算", "积分与微分", "对数与指数", "虚短虚断"]
        },
        {
          "id": "analog-power",
          "name": "功率放大",
          "topics": ["甲类", "乙类", "甲乙类", "交越失真", "效率与输出功率"]
        },
        {
          "id": "analog-frequency",
          "name": "频率响应",
          "topics": ["下限截止频率", "上限截止频率", "波特图", "相位裕度"]
        }
      ]
    },
    {
      "id": "digital",
      "name": "数字电路",
      "chapters": [
        {
          "id": "digital-numeral",
          "name": "数制与编码",
          "topics": ["二进制", "十六进制", "BCD 码", "格雷码", "补码"]
        },
        {
          "id": "digital-boolean",
          "name": "逻辑代数",
          "topics": ["逻辑运算", "公式化简", "反演规则", "对偶规则"]
        },
        {
          "id": "digital-minterm",
          "name": "最小项",
          "topics": ["最小项定义", "标准与或式", "编号 Σm"]
        },
        {
          "id": "digital-maxterm",
          "name": "最大项",
          "topics": ["最大项定义", "标准或与式", "编号 ΠM"]
        },
        {
          "id": "digital-kmap",
          "name": "卡诺图",
          "topics": ["卡诺图填图", "圈组与化简", "任意项", "多变量卡诺图"]
        },
        {
          "id": "digital-combinational",
          "name": "组合逻辑",
          "topics": ["编码器", "译码器", "数据选择器", "加法器", "竞争冒险"]
        },
        {
          "id": "digital-flipflop",
          "name": "触发器",
          "topics": ["RS 触发器", "JK 触发器", "D 触发器", "T 触发器", "状态方程", "状态图"]
        },
        {
          "id": "digital-sequential",
          "name": "时序逻辑",
          "topics": ["时序电路分析", "计数器设计", "状态转换表", "移位寄存器"]
        },
        {
          "id": "digital-memory",
          "name": "存储器",
          "topics": ["ROM", "RAM", "容量与地址", "可编程逻辑"]
        },
        {
          "id": "digital-ad-da",
          "name": "AD/DA",
          "topics": ["数模转换器", "模数转换器", "分辨率与精度", "量化误差"]
        }
      ]
    }
  ]
}
